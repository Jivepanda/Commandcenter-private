<Window x:Class="CommandCentre.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Centre" Height="500" Width="800"
        Background="#0B0D12" Foreground="#E6E8EE">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="COMMAND CENTRE" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,24,0"/>
            <ComboBox x:Name="ModePicker" Width="200" Height="32" FontSize="14"/>
            <Button x:Name="SwitchButton" Content="Switch" Width="100" Height="32"
                    Margin="12,0,0,0" Click="SwitchButton_Click"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,24,0,0"
                 Background="#12151C" Foreground="#8A90A0" BorderBrush="#262B36"
                 FontFamily="Consolas" FontSize="13" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </Grid>
</Window>